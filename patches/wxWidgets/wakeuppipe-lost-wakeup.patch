diff --git a/wxWidgets/include/wx/unix/private/wakeuppipe.h b/wxWidgets/include/wx/unix/private/wakeuppipe.h
index d6bf4c33..db46e90e 100644
--- a/wxWidgets/include/wx/unix/private/wakeuppipe.h
+++ b/wxWidgets/include/wx/unix/private/wakeuppipe.h
@@ -13,6 +13,8 @@
 #include "wx/unix/pipe.h"
 #include "wx/evtloopsrc.h"
 
+#include <atomic>
+
 // ----------------------------------------------------------------------------
 // wxWakeUpPipe: allows to wake up the event loop by writing to it
 // ----------------------------------------------------------------------------
@@ -51,11 +53,20 @@ public:
 private:
     wxPipe m_pipe;
 
-    // This flag is set to true after writing to the pipe and reset to false
+    // UnityHubNative patch (see patches/wxWidgets/README.md): made atomic and
+    // cleared before writing, to fix a lost wake up.
+    //
+    // This flag is set to false before writing to the pipe and reset to true
     // after reading from it in the main thread. Having it allows us to avoid
     // overflowing the pipe with too many writes if the main thread can't keep
     // up with reading from it.
-    bool m_pipeIsEmpty;
+    //
+    // It is atomic because WakeUpNoLock() is also called from signal handlers,
+    // which can run on any thread, concurrently with OnReadWaiting(). It must
+    // be cleared before writing: clearing it after the write let the main
+    // thread drain the pipe in between, leaving the flag wrongly false for good,
+    // so that no later wake up (e.g. SIGCHLD) was ever written to the pipe.
+    std::atomic<bool> m_pipeIsEmpty;
 };
 
 // ----------------------------------------------------------------------------
diff --git a/wxWidgets/src/unix/wakeuppipe.cpp b/wxWidgets/src/unix/wakeuppipe.cpp
index d3af838f..b6bddfab 100644
--- a/wxWidgets/src/unix/wakeuppipe.cpp
+++ b/wxWidgets/src/unix/wakeuppipe.cpp
@@ -67,8 +67,10 @@ wxWakeUpPipe::wxWakeUpPipe()
 
 void wxWakeUpPipe::WakeUpNoLock()
 {
-    // No need to do anything if the pipe already contains something.
-    if ( !m_pipeIsEmpty )
+    // UnityHubNative patch (see patches/wxWidgets/README.md): fixes a lost wake up
+    // No need to do anything if the pipe already contains something. Claim the
+    // right to write before writing, see the comment on m_pipeIsEmpty.
+    if ( !m_pipeIsEmpty.exchange(false) )
       return;
 
     if ( write(m_pipe[wxPipe::Write], "s", 1) != 1 )
@@ -76,11 +78,9 @@ void wxWakeUpPipe::WakeUpNoLock()
         // don't use wxLog here, we can be in another thread and this could
         // result in dead locks
         perror("write(wake up pipe)");
-    }
-    else
-    {
-        // We just wrote to it, so it's not empty any more.
-        m_pipeIsEmpty = false;
+
+        // Nothing was written, so allow trying again.
+        m_pipeIsEmpty = true;
     }
 }
 
